generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model CandidateResponse {
  id                  String   @id @default(uuid())
  email               String   @unique
  name                String?
  phone               String?
  education           String?
  experience          String?
  status              String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, SUSPENDED
  currentSectionIndex Int      @default(0)
  answers             String?  // JSON stringified responses
  logicalScore        Int?
  quantScore          Int?
  completedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
